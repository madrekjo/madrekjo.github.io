      {
        "id": "U03-L05-Q001",
        "number": 1,
        "question": "When do we use the passive rather than the active?",
        "options": {
          "A": "when we don't know who did something or want to focus on the action",
          "B": "when we want to talk about the agent",
          "C": "when we write informal emails",
          "D": "when the subject is a person"
        },
        "correct_answer": "A",
        "correct_answer_text": "when we don't know who did something or want to focus on the action",
        "difficulty": "easy",
        "source": {
          "page": 32,
          "reference": "Grammar reference"
        },
        "solution": {
          "formula": null,
          "steps": [
            "Use the passive when the agent is unknown or less important."
          ],
          "summary": "Focus on the action or object."
        },
        "explanation": "We use it when the doer is obvious or unknown."
      },
      {
        "id": "U03-L05-Q002",
        "number": 2,
        "question": "What is the structure of a passive sentence?",
