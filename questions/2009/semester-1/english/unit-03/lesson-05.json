        "difficulty": "easy",
        "source": {
          "page": 32,
          "reference": "Grammar reference"
        },
        "solution": {
          "formula": null,
          "steps": [
            "The passive uses the verb 'be' plus a past participle."
          ],
          "summary": "be + past participle"
        },
        "explanation": "The past participle changes with tenses."
      },
      {
