# ============================================================
# Question Factory — متغيرات البيئة
# Gemini API
# ============================================================

# مفتاح Gemini API
# ضع مفتاحك هنا ولا ترفعه إلى GitHub
AI_API_KEY=your-gemini-api-key-here

# اسم نموذج Gemini
AI_MODEL=

# مزود الذكاء الاصطناعي
AI_PROVIDER=gemini

# لا نحتاج Base URL مخصص مع Gemini
AI_BASE_URL=

# مهلة الطلب الواحد بالمللي ثانية
AI_TIMEOUT_MS=120000

# عدد المحاولات عند فشل الطلب
AI_MAX_RETRIES=5

# الانتظار بين الطلبات بالمللي ثانية
AI_REQUEST_DELAY_MS=5000
